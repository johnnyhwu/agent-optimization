# Reference values. Running through docker-compose (./scripts/dev.sh) you don't
# need this file at all — compose passes these in, and real environment
# variables win over a .env. Copy it to .env only when you run the backend
# outside the container; then keep the Postgres host as localhost.

# Async URL used by the FastAPI app (asyncpg driver).
# Inside the compose network the host is the service name `db`, not localhost.
DATABASE_URL=postgresql+asyncpg://agentopt:agentopt@localhost:5432/agentopt
# Sync URL used by Alembic migrations (psycopg driver).
SYNC_DATABASE_URL=postgresql+psycopg://agentopt:agentopt@localhost:5432/agentopt

# ===========================================================================
# Identity (§6.16)
#
#   fake      trust an X-User-Subject header. Local development, the seeded demo
#             and the owner/viewer switch in the top bar all run on this.
#   keycloak  verify a real bearer token; the subject is the token's
#             preferred_username claim.
#
# Only `current_subject` branches on this — every role check below it takes a
# subject string and is identical either way.
#
# The frontend has a matching switch (VITE_AUTH_MODE / the AUTH_MODE written into
# /config.js). The two must agree: a fake frontend sends no token, and a keycloak
# backend rejects anything without one.
# ===========================================================================
AUTH_MODE=fake

# fake mode only. Flip between the seeded subjects to test role guards; the seed
# creates "alice" (owner) and "bob" (viewer).
FAKE_USER_SUBJECT=alice

# --- keycloak mode ---
# Base URL *including* any relative path the deployment is served under.
# Keycloak dropped the historical /auth prefix in 17, but a deployment can put it
# back — copy whatever your realm actually answers on.
KEYCLOAK_URL=
KEYCLOAK_REALM=tsmc
KEYCLOAK_CLIENT_ID=ai4bi-public
# Expected `aud` claim; blank disables the check entirely.
#
# This is a deployment unknown worth reading twice: Keycloak only puts the client
# id in `aud` when an audience mapper says so, and otherwise emits something else
# ("account" most often). A wrong value here rejects *every* token. The 401 names
# the value the token actually carried, so the first failed sign-in tells you
# what to put here.
KEYCLOAK_AUDIENCE=ai4bi-public

# --- Employee directory (the share picker) ---
# Resolves a typed username before it is written into eval_set_roles — without
# it, a typo shares an eval set with an account that never signs in, and nothing
# reports it. Keyed by the same string as preferred_username.
HR_API_BASE_URL=https://cpochatproxyservice.cpoap-dev.dev.tsmc.com/proxy/employees
# The internal service presents a self-signed certificate. Turn this on once the
# corporate CA bundle is installed in the backend image.
HR_API_VERIFY_SSL=false
HR_API_TIMEOUT_S=5

# --- Trusting an internal certificate authority ---
# Internal services (Keycloak, Langfuse, the agent server, the employee
# directory) present certificates signed by a private CA. The container's base
# image trusts only the public roots that ship with certifi, so every outbound
# HTTPS call fails until it is told where to look:
#
#   [SSL: CERTIFICATE_VERIFY_FAILED] unable to get local issuer certificate
#
# The giveaway is that `curl` to the same URL succeeds from the host and fails
# from inside the container.
#
# httpx reads this whenever verify=True — which is what every seam uses — so one
# value covers Keycloak, Langfuse, the agent server and the LLM endpoint at once.
#
# ⚠️ It REPLACES the trust store rather than adding to it, so the file must also
# contain the public roots. Copying the host's own bundle gets both:
#
#   cp /etc/ssl/certs/ca-certificates.crt backend/certs/ca-bundle.crt
#
# See backend/certs/README.md.
SSL_CERT_FILE=/app/certs/ca-bundle.crt

# CORS origin of the Vite dev server. Inert behind nginx, where the bundle and
# the API share one origin and no CORS check happens at all.
FRONTEND_ORIGIN=http://localhost:5173

# Prefix a reverse proxy strips before forwarding (nginx `proxy_pass …:8000/`
# under `location /api/`). Routes are unaffected; this is what keeps the
# generated /docs and /openapi.json URLs pointing back through the prefix.
# Set to /api by docker-compose.prod.yml; leave blank when running directly.
ROOT_PATH=

# ===========================================================================
# Real integrations (§9.2, §10.2). Everything below is optional: leave the five
# *_IMPL switches on "fake" and the seeded demo runs with no external service.
#
# When running through docker-compose these are read from your shell or a
# repo-root .env — docker-compose.yml forwards them into the backend container.
# Bring the seams up one at a time; `python -m app.check_integrations` pings
# whichever ones are set to "real".
#
# The *_IMPL switches are the master switch for fake vs real. The connection
# settings below (base URLs, models, timeouts, credentials, concurrency) are
# only the *defaults*: the "Run eval" dialog prefills from them and each run
# stores the settings it was triggered with, so two runs can hit different
# agent servers or judge models without touching this file. A field left blank
# in the dialog falls back to the value here.
# ===========================================================================

# fake | real, per seam.
AGENT_IMPL=fake
JUDGE_IMPL=fake
TRACE_IMPL=fake
DIAGNOSIS_IMPL=fake
# Drafts an expected reasoning process from a trace, on the shortlist's button.
# Shares the LLM endpoint with the judge and the diagnosis.
SYNTHESIS_IMPL=fake
# The agent's skill files: one GET {AGENT_BASE_URL}/skills. Read-only against
# the agent server, so this is the cheapest seam to switch on first — and it
# gates the Run-eval Start button and the playground's Connect, so it is also
# the first one worth having. Nothing is ever written back.
WORKSPACE_IMPL=fake
# The model that turns scored rollouts into skill edits — Optimize's analyst,
# merge and ranking stages. Set this to `real` and the skill edits are written
# by OPTIMIZER_MODEL against LLM_BASE_URL instead of being canned.
#
# Switching it on needs three things, and it fails loudly if any is missing:
# OPTIMIZER_MODEL (below), LLM_BASE_URL + LLM_API_KEY, and TRACE_IMPL=real —
# the analyst reads traces, and a fake trace store gives it nothing real to
# reason about.
OPTIMIZER_IMPL=fake

# --- Agent HTTP server (§6.2) ---
# A FastAPI server with a single POST /execute endpoint that takes
# {"message": str, "metadata": dict} and returns {"content": str} with the
# agent's answer.
# The platform mints a correlation_id per question and sends it as
# metadata.trace_data.trace_id (and reuses it as session_id); metadata also
# carries user_id (who triggered the run) and tags (the eval set name). The
# agent server applies trace_id as its Langfuse trace id, which is how the
# trace is found again.
AGENT_BASE_URL=
AGENT_TIMEOUT_S=120
AGENT_MAX_RETRIES=2
# Every call also carries metadata.timeout_s: how long the agent server should
# allow itself for this one question. It is AGENT_TIMEOUT_S minus a fixed 5s
# margin (see app/integrations/real/agent.py), so the server runs out first and
# can answer with a reason instead of the platform simply dropping the
# connection.

# --- LLM: any OpenAI-compatible endpoint (judge + diagnosis) ---
LLM_BASE_URL=http://litellm-ai4bi.cpoap-dev.dev.tsmc.com
LLM_API_KEY=
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
JUDGE_MODEL=Qwen3.6-27B
DIAGNOSIS_MODEL=Qwen3.6-27B
# Deliberately separate from the two above: this is the one call in the loop
# that reasons about a whole minibatch of traces at once, so it is the one worth
# pointing at a stronger model. Required when OPTIMIZER_IMPL=real.
OPTIMIZER_MODEL=Qwen3.6-27B
# Leave empty to trust the verdict the judge returns. Set a 0-1 number to derive
# the verdict from the judge's score instead (score >= threshold -> correct),
# so the pass/fail boundary can be retuned without editing the prompt.
JUDGE_SCORE_THRESHOLD=

# --- Langfuse (trace store; read-only in Stage 1) ---
LANGFUSE_HOST=http://langfuse-ai4bi.cpoap-dev.dev.tsmc.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TIMEOUT_S=60
# Which read API a trace's observations come from:
#   auto              try GET /api/public/traces/{id}, then the v2 observations
#                     list; first one to answer wins (default)
#   trace_api         only GET /api/public/traces/{id}
#   observations_api  only GET /api/public/v2/observations?traceId=
# Two endpoints because Langfuse serves them with different internal queries,
# and some self-hosted builds (~3.152+) fail one of them with a raw ClickHouse
# error about a missing `events` table. See "Langfuse read strategies" in
# README.md — the real fix is on the Langfuse deployment. Pin a single strategy
# once yours is known-good to skip the wasted first call.
LANGFUSE_TRACE_READ_STRATEGY=auto

# --- Run execution ---
# 1 = strictly sequential (the original behaviour). Raise to run questions
# against the agent concurrently.
RUN_CONCURRENCY=1
# Trace-ready polling (§6.12). Real Langfuse ingestion can lag tens of seconds.
TRACE_POLL_MAX_ATTEMPTS=8

# --- Optimize: what a run is prefilled with ---
# The wizard's starting numbers. Here rather than in the code because they are a
# deployment's answer to "how big is a step against this agent".
OPTIMIZER_BATCH_SIZE=8
# Trajectories per analyst call — independent of the batch size above. A step
# answers its batch, then reflects on it in groups of this size, failures and
# successes grouped separately. Lower it when the optimizer model refuses a call
# for being too long; it splits the reading into more, smaller prompts rather
# than shrinking what the step measures.
OPTIMIZER_MINIBATCH_SIZE=8
OPTIMIZER_LEARNING_RATE=8
OPTIMIZER_MIN_LEARNING_RATE=2
# How many analyst calls run at once, and how many proposed patches one merge
# call combines. Both are about throughput against your optimizer endpoint, not
# about what the run produces.
OPTIMIZER_ANALYST_WORKERS=4
OPTIMIZER_MERGE_BATCH_SIZE=8
# The shape choices. `hard` compares exact-match accuracy, `soft` the judge's
# partial credit, `mixed` a weighted average — MIXED_WEIGHT is how much of that
# average is soft, and 0 is a legal value meaning "hard alone".
OPTIMIZER_SCHEDULER=constant
OPTIMIZER_GATE_METRIC=hard
OPTIMIZER_MIXED_WEIGHT=0.5
# Show the analyst only the questions that failed. Off by default: what the
# skill got right is evidence too.
OPTIMIZER_FAILURE_ONLY=false
# Upstream's two longitudinal passes, each one call on the optimizer model per
# epoch boundary. Off by default, and a one-epoch run gets nothing from either.
OPTIMIZER_SLOW_UPDATE=false
OPTIMIZER_META_SKILL=false

# --- Optimize: when a run stops early ---
# Four conditions, one mechanism (app/optimizer/stopping.py). The two error
# settings are pairs: the *share* is how much of one split may fail before its
# numbers are refused as unrepresentative, the *streak* is how many refused
# rollouts in a row are an agent server that has stopped answering rather than a
# bad afternoon. A refused rollout costs its own step, never the run — except at
# the baseline, which every later number is compared against.
EARLY_STOP_TRAIN_ERROR_SHARE=0.25
EARLY_STOP_TRAIN_ERROR_STREAK=3
EARLY_STOP_VAL_ERROR_SHARE=0.25
EARLY_STOP_VAL_ERROR_STREAK=3
# Steps without a new best before the run stops. 0 is off, and is the default:
# this one changes what a run produces rather than protecting it from an outage.
EARLY_STOP_PATIENCE=0
# Stop as soon as validation reaches this (0-1). Blank is off.
EARLY_STOP_TARGET_SCORE=

# --- Playground (§10) ---
# Attempts are deliberately not persisted, so they live in this process's memory
# and a backend restart clears them. One attempt holds a whole trace (hundreds of
# KB for a real agent), so the store is capped per subject; the oldest finished
# attempts are evicted first.
PLAYGROUND_MAX_ATTEMPTS_PER_USER=20

# ===========================================================================
# Deployment (docker-compose.prod.yml)
#
# Set these in a repo-root .env before `make prod-up`. Compose refuses to start
# without them rather than quietly falling back to development values.
#
#   POSTGRES_PASSWORD    no default — the development password must not ship
#   DATABASE_URL         must match POSTGRES_PASSWORD (percent-encode reserved
#   SYNC_DATABASE_URL    characters); required so a changed password fails at
#                        start-up rather than at connect time
#   KEYCLOAK_URL         required whenever AUTH_MODE=keycloak
#   AUTH_MODE            defaults to keycloak there
#   FRONTEND_PORT        the one published port; defaults to 5173, which keeps
#                        the app's URL identical to development so a single
#                        redirect URI registration in Keycloak covers both
#
# Register all three of these in Keycloak for the client, or sign-in breaks in
# ways that name nothing useful:
#   Valid Redirect URIs             http://<host>:5173/*
#   Valid Post Logout Redirect URIs http://<host>:5173/*   (logout only)
#   Web Origins                     http://<host>:5173     (the token exchange)
# ===========================================================================
