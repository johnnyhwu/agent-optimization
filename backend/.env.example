# Reference values. Running through docker-compose (./scripts/dev.sh) you don't
# need this file at all — compose passes these in, and real environment
# variables win over a .env. Copy it to .env only when you run the backend
# outside the container; then keep the Postgres host as localhost.

# Async URL used by the FastAPI app (asyncpg driver).
# Inside the compose network the host is the service name `db`, not localhost.
DATABASE_URL=postgresql+asyncpg://agentopt:agentopt@localhost:5432/agentopt
# Sync URL used by Alembic migrations (psycopg driver).
SYNC_DATABASE_URL=postgresql+psycopg://agentopt:agentopt@localhost:5432/agentopt

# --- Fake login switch (Stage 1, §6.16) ---
# Flip this between the seeded owner and viewer subjects to test role guards.
# Seed creates: owner subject "alice" (owner) and "bob" (viewer).
FAKE_USER_SUBJECT=alice

# CORS origin of the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# ===========================================================================
# Real integrations (§9.2). Everything below is optional: leave the four
# *_IMPL switches on "fake" and the seeded demo runs with no external service.
#
# When running through docker-compose these are read from your shell or a
# repo-root .env — docker-compose.yml forwards them into the backend container.
# Bring the seams up one at a time; `python -m app.check_integrations` pings
# whichever ones are set to "real".
#
# The *_IMPL switches are the master switch for fake vs real. The connection
# settings below (base URLs, models, timeouts, credentials, concurrency) are
# only the *defaults*: the "Run eval" dialog prefills from them and each run
# stores the settings it was triggered with, so two runs can hit different
# agent servers or judge models without touching this file. A field left blank
# in the dialog falls back to the value here.
# ===========================================================================

# fake | real, per seam.
AGENT_IMPL=fake
JUDGE_IMPL=fake
TRACE_IMPL=fake
DIAGNOSIS_IMPL=fake

# --- Agent HTTP server (§6.2) ---
# A FastAPI server with a single POST /execute endpoint that takes
# {"message": str, "metadata": dict} and returns {"content": str} with the
# agent's answer.
# The platform mints a correlation_id per question and sends it as
# metadata.trace_data.trace_id (and reuses it as session_id); metadata also
# carries user_id (who triggered the run) and tags (the eval set name). The
# agent server applies trace_id as its Langfuse trace id, which is how the
# trace is found again.
AGENT_BASE_URL=
AGENT_TIMEOUT_S=120
AGENT_MAX_RETRIES=2

# --- LLM: any OpenAI-compatible endpoint (judge + diagnosis) ---
LLM_BASE_URL=http://litellm-ai4bi.cpoap-dev.dev.tsmc.com
LLM_API_KEY=
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
JUDGE_MODEL=Qwen3.6-27B
DIAGNOSIS_MODEL=Qwen3.6-27B
# Leave empty to trust the verdict the judge returns. Set a 0-1 number to derive
# the verdict from the judge's score instead (score >= threshold -> correct),
# so the pass/fail boundary can be retuned without editing the prompt.
JUDGE_SCORE_THRESHOLD=

# --- Langfuse (trace store; read-only in Stage 1) ---
LANGFUSE_HOST=http://langfuse-ai4bi.cpoap-dev.dev.tsmc.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TIMEOUT_S=60

# --- Run execution ---
# 1 = strictly sequential (the original behaviour). Raise to run questions
# against the agent concurrently.
RUN_CONCURRENCY=1
# Trace-ready polling (§6.12). Real Langfuse ingestion can lag tens of seconds.
TRACE_POLL_MAX_ATTEMPTS=8
