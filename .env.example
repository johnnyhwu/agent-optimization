# Every variable docker-compose interpolates, with its shipped default.
#
# Copy to `.env` in this directory and edit. Compose reads that file
# automatically, so `./scripts/dev.sh`, `./scripts/prod.sh` and every `make`
# target pick it up with no extra flags. `.env` is gitignored; this file is the
# tracked reference, which `.gitignore` has claimed for a while and until now was
# not true — there was no such file, so the only place to find a variable's name
# was `docker-compose.yml`.
#
# Two things worth knowing before you edit.
#
#   * A value set in your shell beats a value in `.env`. If a variable seems to
#     be ignored, check `env | grep SCRIPT_` before checking the code.
#   * A misspelled name is discarded in silence. The backend's settings are
#     `extra="ignore"` (app/config.py), so `SCRIPT_MAX_QURIES=300` neither warns
#     nor fails — the limit simply stays at its default. The backend logs the
#     effective script limits at startup and the upload dialog prints them, so
#     check there rather than assuming the value arrived.
#
# Commented-out lines are the defaults; uncomment only what you are changing.

# --- Database ---------------------------------------------------------------
# Required in the deployed form (docker-compose.prod.yml), which refuses to
# start rather than deploy the development password.
# POSTGRES_USER=agentopt
# POSTGRES_DB=agentopt
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+asyncpg://agentopt:agentopt@db:5432/agentopt
# SYNC_DATABASE_URL=postgresql+psycopg://agentopt:agentopt@db:5432/agentopt

# --- Personal defaults -------------------------------------------------------
# The settings page (right-hand user menu) lets each developer keep their own
# defaults for the values below that a form already lets them override. Nothing
# here is required: with no saved settings every form opens exactly on this
# file's values, which is what it did before the page existed.
#
# SETTINGS_SECRET_KEY turns on the *credential* half of that page — the LLM API
# key and the Langfuse secret key. Blank leaves it off, and there is deliberately
# no plaintext fallback. It is also ignored under AUTH_MODE=fake, where identity
# is a header the caller sets and a long-lived credential keyed on that would be
# a hole rather than a convenience.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SETTINGS_SECRET_KEY=

# --- Sign-in ----------------------------------------------------------------
# `fake` trusts a header and shows the owner/viewer switcher; `keycloak` runs
# real OIDC. KEYCLOAK_URL is required when AUTH_MODE=keycloak.
# AUTH_MODE=fake
# FAKE_USER_SUBJECT=alice
# KEYCLOAK_URL=
# KEYCLOAK_REALM=tsmc
# KEYCLOAK_CLIENT_ID=ai4bi-public
# KEYCLOAK_AUDIENCE=

# --- Which seams are real ----------------------------------------------------
# Each defaults to `fake` and can be switched independently — see the README's
# "Going from fake to real".
# AGENT_IMPL=fake
# JUDGE_IMPL=fake
# TRACE_IMPL=fake
# DIAGNOSIS_IMPL=fake
# SYNTHESIS_IMPL=fake
# WORKSPACE_IMPL=fake
# OPTIMIZER_IMPL=fake

# --- Real integrations -------------------------------------------------------
# Credentials come from here or from the host environment; they are never baked
# into an image.
# AGENT_BASE_URL=
# AGENT_TIMEOUT_S=120
# How long the "Run eval" dialog's pre-flight waits for the agent server before
# calling it unreachable. Deliberately separate from AGENT_TIMEOUT_S, which is
# the budget for answering a question: the Start button stays disabled until this
# check answers, so borrowing two minutes would make the dialog unusable against
# a hung agent.
# AGENT_PROBE_TIMEOUT_S=5
# LLM_BASE_URL=
# LLM_API_KEY=
# JUDGE_MODEL=Qwen3.6-27B
# DIAGNOSIS_MODEL=Qwen3.6-27B
# Whether a run diagnoses its wrong answers unless the person starting it says
# otherwise. This is the box the "Run eval" dialog opens with, not a master
# switch — the choice is per run and recorded in the run's config. Off costs one
# fewer LLM call per wrong answer; the per-question re-diagnose still works.
# DIAGNOSIS_ENABLED=true
# SYNTHESIS_MODEL=Qwen3.6-27B
# OPTIMIZER_MODEL=Qwen3.6-27B
# JUDGE_SCORE_THRESHOLD=
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_TIMEOUT_S=60
# TRACE_SETTLE_DELAY_S=1.0
# TRACE_SETTLE_MAX_READS=3

# --- Optimization runs -------------------------------------------------------
# What the "Run eval" wizard prefills. Each is a default, not a ceiling: the run
# stores whatever it was started with, so changing one moves the starting point
# for new runs and leaves existing ones alone.
# OPTIMIZER_NUM_EPOCHS=1
# OPTIMIZER_BATCH_SIZE=8
# How many trajectories one analyst call may carry. Independent of
# OPTIMIZER_BATCH_SIZE, and the one that decides whether that call fits in the
# optimizer model's context window.
# OPTIMIZER_MINIBATCH_SIZE=8
# OPTIMIZER_LEARNING_RATE=8
# OPTIMIZER_MIN_LEARNING_RATE=2
# OPTIMIZER_ANALYST_WORKERS=4
# OPTIMIZER_MERGE_BATCH_SIZE=8
# OPTIMIZER_SCHEDULER=constant
# OPTIMIZER_GATE_METRIC=hard
# OPTIMIZER_MIXED_WEIGHT=0.5
# OPTIMIZER_FAILURE_ONLY=false
# OPTIMIZER_SLOW_UPDATE=false
# OPTIMIZER_META_SKILL=false

# --- Early stopping ----------------------------------------------------------
# A share is what fraction of one split may fail before that split's numbers are
# refused; a streak is how many times in a row that may happen before the run
# stops. Raise the shares on an agent server known to drop the occasional
# question, rather than watching runs stop on it.
# EARLY_STOP_TRAIN_ERROR_SHARE=0.25
# EARLY_STOP_TRAIN_ERROR_STREAK=3
# EARLY_STOP_VAL_ERROR_SHARE=0.25
# EARLY_STOP_VAL_ERROR_STREAK=3
# Steps without a new best before the run stops; 0 is off.
# EARLY_STOP_PATIENCE=0
# Stop as soon as validation reaches this. Blank is off.
# EARLY_STOP_TARGET_SCORE=

# --- Eval-set scripts --------------------------------------------------------
# An eval set can be built by uploading a Python script that queries a business
# database. Every number here is a containment boundary rather than a
# preference — see backend/app/services/script_runner.py for what each one
# prevents — so raise them deliberately.
#
# SCRIPT_MAX_QUERIES is the one people meet first, and usually because a script
# issues one query per row instead of fetching a set and looping over it in
# Python. Raising it is legitimate; so is rewriting the script.
# SCRIPT_MAX_QUERIES=50
# SCRIPT_MAX_ROWS_PER_QUERY=50000
# SCRIPT_STATEMENT_TIMEOUT_S=600
# Raising this alone is not enough in the deployed form: nginx has to be willing
# to hold the request open at least as long, or it answers 504 first. See
# proxy_read_timeout in frontend/nginx.conf.template.
# SCRIPT_WALL_CLOCK_S=600
# SCRIPT_MAX_OUTPUT_CHARS=262144
# SCRIPT_MEMORY_MB=1024
# There is one uvicorn worker, and each run forks a process and holds a worker
# thread for up to SCRIPT_WALL_CLOCK_S.
# SCRIPT_MAX_CONCURRENT_RUNS=2

# --- Everything else ---------------------------------------------------------
# FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_PORT=5173
# RUN_CONCURRENCY=1
# PLAYGROUND_MAX_ATTEMPTS_PER_USER=20
# HR_API_BASE_URL=
# HR_API_TIMEOUT_S=10
# HR_API_VERIFY_SSL=true
